# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# Required for Ask Ozzy chat (app/api/ozzy). Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Required for the data-review tool at /review and its API (app/api/proposals).
# Without this set, /api/proposals refuses every request (fails closed) — the
# review page will ask for whatever value you set here.
REVIEW_ADMIN_TOKEN=
